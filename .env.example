# Supabase (publishable values; safe in the browser when row-level security is on)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Razorpay payment links for the pilot packs. A pack without a link is hidden.
VITE_PAYMENT_LINK_5=https://rzp.io/l/your-99-link
VITE_PAYMENT_LINK_10=https://rzp.io/l/your-199-link
VITE_PAYMENT_LINK_30=https://rzp.io/l/your-499-link
VITE_CREDIT_TOPUP_PROMISE=within 2 hours (8am-11pm)

# Features off for the pilot. Set to true to bring one back.
# VITE_FEATURE_VIDEO_FEEDBACK=true
# VITE_FEATURE_AUDIO_FEEDBACK=true
# VITE_FEATURE_LEADERBOARD=true
# VITE_FEATURE_STREAK_FREEZE=true

# Edge-function secrets (set in Supabase: Edge Functions -> Secrets, not here).
# Any OpenAI-compatible provider works; free open-model defaults shown.
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=<groq key>
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_REASONING_EFFORT=low
#   LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#   LLM_FALLBACK_API_KEY=<openrouter key>
#   LLM_FALLBACK_MODEL=qwen/qwen3.8-27b:free
#   VISION_BASE_URL=https://openrouter.ai/api/v1      (reads answer photos)
#   VISION_API_KEY=<openrouter key>
#   VISION_MODEL=qwen/qwen3.8-27b:free
# Optional paid alternatives, used only if set:
#   AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY, AZURE_OPENAI_DEPLOYMENT (tried after the LLM_* providers)
#   AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT, AZURE_DOCUMENT_INTELLIGENCE_API_KEY + OCR_PROVIDER=azure
#   ALLOWED_ORIGINS (comma-separated, default *)
